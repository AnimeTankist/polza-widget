<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>PolzaWidget</AssemblyName>
    <RootNamespace>PolzaWidget</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Polza Widget</Product>
    <AssemblyTitle>Виджет расходов polza.ai</AssemblyTitle>
    <Description>Карточка расходов за сегодня с API polza.ai</Description>
    <Company>Polza Widget</Company>
    <Copyright>MIT</Copyright>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <Prefer32Bit>false</Prefer32Bit>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
